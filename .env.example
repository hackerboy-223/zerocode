# zerocode lit les cles depuis l'environnement ou depuis
# ~/.config/zerocode/keys.json (recommande: `zerocode setup`).
# Ne commite jamais ce fichier avec de vraies cles.

# Aucune cle n'est obligatoire: zerocode demarre avec le routage
# gratuit et sans compte de Kilo Gateway. Les cles ci-dessous
# debloquent des modeles GLM supplementaires et d'autres fournisseurs.

# GLM 5.3 / GLM 5.3 Flash (essai gratuit)
NVIDIA_API_KEY=
TOGETHER_API_KEY=

# GLM 5.3 Flash gratuit + autres modeles gratuits
OPENCODE_ZEN_API_KEY=

# GLM 4.7 Flash et 4.5 Flash gratuits, GLM 5.3 payant
ZAI_API_KEY=

# Modeles gratuits :free
OPENROUTER_API_KEY=

# Offres gratuites
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
SAMBANOVA_API_KEY=

# Optionnel : quota superieur sur Kilo Gateway
KILO_API_KEY=

# Optionnel : Ollama local (http://localhost:11434/v1)
# OLLAMA_BASE_URL=http://localhost:11434/v1
