APP_ENV=development
DATABASE_URL=postgresql+psycopg://zerocode:zerocode@localhost:5432/zerocode_cloud
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-bytes
FERNET_KEY=generate-with-python-c-cryptography-fernet-Fernet-generate_key
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
ALLOW_PUBLIC_SIGNUP=true
CORS_ORIGINS=http://localhost:1420,http://localhost:5173
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-this-immediately
AUTO_CREATE_SCHEMA=false
UPSTREAM_TIMEOUT_SECONDS=120
ALLOW_LOCAL_PROVIDER_URLS=false
